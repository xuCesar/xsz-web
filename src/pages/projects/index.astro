---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = await getCollection('projects', ({ data }) => data.status === 'published');
const updatedValue = (date: Date | undefined, fallback: Date) => date?.valueOf() ?? fallback.valueOf();
projects.sort((a, b) => updatedValue(b.data.updated, b.data.date) - updatedValue(a.data.updated, a.data.date));
const contentSlug = (id: string) => id.replace(/\/index$/, '');
---

<BaseLayout title="作品" description="xsz 的项目与实践。">
	<section class="page-intro">
		<h1 class="page-heading">作品</h1>
		<p>记录做过的项目，也记录项目背后的判断、取舍和过程。</p>
	</section>
	<section class="section" aria-label="项目列表">
		<div class="project-grid">
			{projects.map((project) => (
				<a class="project-card" href={`/projects/${contentSlug(project.id)}`}>
					<div class="project-media">{project.data.cover && <Image src={project.data.cover} alt={project.data.coverAlt ?? project.data.title} sizes="(max-width: 800px) 100vw, 33vw" />}</div>
					<h2 class="project-title">{project.data.title}</h2>
					<p class="project-summary">{project.data.summary}</p>
					<p class="project-meta">{project.data.tech.join(' · ')}</p>
				</a>
			))}
		</div>
	</section>
</BaseLayout>
