---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

const [writing, projects] = await Promise.all([
	getCollection('writing', ({ data }) => data.status === 'published'),
	getCollection('projects', ({ data }) => data.status === 'published'),
]);

const updatedValue = (date: Date | undefined, fallback: Date) => date?.valueOf() ?? fallback.valueOf();
const featuredProjects = projects.filter(({ data }) => data.featured).sort((a, b) => updatedValue(b.data.updated, b.data.date) - updatedValue(a.data.updated, a.data.date)).slice(0, 3);
const latestWriting = writing.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const heroProject = featuredProjects[0];
const formatDate = (date: Date) => date.toISOString().slice(0, 10).replaceAll('-', '.');
const typeLabel = { technical: '技术', life: '随笔', opinion: '观点', note: '笔记' } as const;
const contentSlug = (id: string) => id.replace(/\/index$/, '');
---

<BaseLayout title="首页">
	<section class="hero">
		<div>
			<h1>把做过的事写下来，把还在思考的问题留在这里。</h1>
			<p class="hero-copy">这是 xsz 的个人空间：记录项目如何被做出来，也记录技术之外那些值得慢慢想清楚的事。</p>
			<div class="hero-actions">
				<a class="text-link" href="/writing">阅读文章 <span class="arrow" aria-hidden="true">→</span></a>
				<a class="text-link" href="/projects">查看作品 <span class="arrow" aria-hidden="true">→</span></a>
			</div>
		</div>
		{heroProject?.data.cover && (
			<div class="hero-image">
				<Image src={heroProject.data.cover} alt={heroProject.data.coverAlt ?? heroProject.data.title} sizes="(max-width: 800px) 65vw, 320px" />
			</div>
		)}
	</section>

	<section class="section" aria-labelledby="projects-heading">
		<h2 class="section-heading" id="projects-heading">精选作品</h2>
		<hr class="section-rule" />
		<div class="project-grid">
			{featuredProjects.map((project) => (
				<a class="project-card" href={`/projects/${contentSlug(project.id)}`}>
					<div class="project-media">
						{project.data.cover && <Image src={project.data.cover} alt={project.data.coverAlt ?? project.data.title} sizes="(max-width: 800px) 100vw, 33vw" />}
					</div>
					<h3 class="project-title">{project.data.title}</h3>
					<p class="project-summary">{project.data.summary}</p>
					<p class="project-meta">{project.data.tech.join(' · ')}</p>
				</a>
			))}
		</div>
		<a class="text-link section-link" href="/projects">查看全部作品 <span class="arrow" aria-hidden="true">→</span></a>
	</section>

	<section class="section" aria-labelledby="writing-heading">
		<h2 class="section-heading" id="writing-heading">最近文章</h2>
		<hr class="section-rule" />
		<div class="writing-list">
			{latestWriting.map((entry) => (
				<a class="writing-row" href={`/writing/${contentSlug(entry.id)}`}>
					<div class="writing-meta"><div>{formatDate(entry.data.date)}</div><div class="writing-type">{typeLabel[entry.data.type]}</div></div>
					<div class="writing-title">{entry.data.title}</div>
				</a>
			))}
		</div>
		<a class="text-link section-link" href="/writing">查看全部文章 <span class="arrow" aria-hidden="true">→</span></a>
	</section>
</BaseLayout>
